{
"build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "ndd-sql",
    "version": "3.0.1"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "notification": {
        "all": true
      }
    },
  "bundle": {
        "active": true,
        "targets": ["nsis", "updater"],
        "identifier": "com.ndd-sql.monitoramento",
        "icon": [
          "icons/32x32.png",
          "icons/128x128.png",
          "icons/128x128@2x.png",
          "icons/icon.icns",
          "icons/icon.ico"
        ],
        "windows": {
          "nsis": {
            "installMode": "currentUser"
          }
        }
      },

      "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },

      "updater": {
      "active": true,
      "dialog": true,
      "endpoints": [
        "https://raw.githubusercontent.com/danielcunhagit/NDD_iW_SQL/main/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERENEQ5RUQ4QTg5RDU5NDAKUldSQVdaMm8ySjVOM1JjNkY1dm56WlVZaDlMQTJWLzFXaVYxVk9HMG5RL3NZaEszSWVub0RDMVcK"
    },
    "security": {
      "csp": null
    },
"windows": [
      {
        "fullscreen": false,
        "resizable": false,
        "title": "Monitoramento RPA",
        "width": 450,
        "height": 350,
        "center": true,
        "decorations": false,
        "label": "main"
      },
      {
        "label": "notification",
        "url": "index.html",
        "fullscreen": false,
        "resizable": false,
        "title": "NDD Alerta",
        "width": 420,
        "height": 250,
        "center": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ]
  }
}